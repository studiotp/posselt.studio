---
import { readFileSync } from 'fs';
import { marked } from 'marked';
import PageLayout from '../layouts/PageLayout.astro';

const privacyMd = readFileSync('./src/data/privacy.md', 'utf-8');
const privacyHtml = await marked(privacyMd);
---

<PageLayout
  title="Privacy - Studio Torsten Posselt"
  description="Disclaimer and data privacy agreement for Studio Torsten Posselt."
  themeClass="bg-orange"
  bodyClass="page-privacy"
>
<div class="bg-orange px-2 lg:px-3 page">
    <div class="lg:pl-4">
        <div class="flex justify-end -mr-2 md:mr-0 mb-15 pt-20 md:py-2">
            <div class="w-[calc(var(--logo-width)+var(--corner-margin)+2rem)] md:w-1/2">
                <h1 class="text-lg md:text-xl relative md:z-30">Privacy</h1>
            </div>
        </div>

        <div class="md:flex pb-10">
            <div class="lg:w-6/12 text-md text" set:html={privacyHtml}></div>
        </div>
    </div>
</div>
</PageLayout>
