---
import PageLayout from '../layouts/PageLayout.astro';
import { marked } from 'marked';
import data from '../data/contact.json';
---

<PageLayout
  title={data.title}
  description={data.description}
  themeClass={data.themeClass}
  bodyClass={data.bodyClass}
>
<div class={`${data.themeClass} px-2 lg:px-3 page link-hover-opacity`}>
    <div class="lg:pl-4">
        <div class="flex justify-end -mr-2 md:mr-0 mb-15 pt-20 md:py-3">
            <div class="w-[calc(var(--logo-width)+var(--corner-margin)+2rem)] md:w-1/2">
                <h1 class="text-lg md:text-xl relative md:z-30">{data.heading}</h1>
            </div>
        </div>

        <div class="md:flex pb-3">
            <div class="lg:w-7/12 text-lg md:text-xl text leading-large">
                <p set:html={marked(data.address.replace(/\n/g, '  \n'))}></p>
                <p><a href={data.mapsUrl} target="_blank" rel="noopener"></a></p>
            </div>
        </div>

        <div class="md:flex justify-start columns lg:w-10/12 xl:w-9/12">
            {data.columns.map((col) => (
              <div class="md:w-5/12 lg:w-1/3 column pb-10">
                  {col.label}
                  <div class="text-lg md:text-xl text" set:html={marked(col.content)}></div>
              </div>
            ))}
        </div>
    </div>
</div>
</PageLayout>
