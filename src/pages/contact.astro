---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Contact - Studio Torsten Posselt"
  description="STP is a multidisciplinary design studio that focuses equally on the creation and production of bespoke artworks and design applications."
  themeClass="bg-yellow"
  bodyClass="page-contact"
>
<div class="bg-yellow px-2 lg:px-3 page link-hover-opacity">

    <div class="lg:pl-4">

        <div class="flex justify-end mb-15 pt-20 md:py-2">

            <div class="w-1/2">

                <h1 class="text-lg md:text-xl relative md:z-30">Contact</h1>

            </div>

        </div>

        <div class="md:flex pb-3">

            <div class="lg:w-7/12 text-lg md:text-xl text leading-large">
                <p>Studio<br>
Torsten Posselt<br>
Urbanstraße 116<br>
10967 Berlin<br>
Germany</p>
<p><a href="https://goo.gl/maps/a3skbENJEC4vn1Tj8" target="_blank" rel="noopener">Maps</a></p>
            </div>

        </div>

        <div class="md:flex justify-start columns lg:w-10/12 xl:w-9/12">

            <div class="md:w-5/12 lg:w-1/3 column pb-10">
                                            For general inquiries                            <div class="text-lg md:text-xl text">
                                <p>ahoi@posselt.studio</p>
                            </div>
                                    </div>

            <div class="md:w-4/12 lg:w-1/3 column pb-10">
                                            VAT No.                            <div class="text-lg md:text-xl text">
                                <p>DE325612420</p>
                            </div>
                                    </div>

            <div class="md:w-3/12 lg:w-1/3 column pb-10">

                                            Connect with us                            <div class="text-lg md:text-xl text contact-social">
                                <p><a href="https://www.instagram.com/studio_t_p/" target="_blank" rel="noopener">Instagram</a> <a href="https://vimeo.com/studiotp" target="_blank" rel="noopener">Vimeo</a></p>
                            </div>
                        
            </div>

        </div>

    </div>

</div>

<!-- footer -->
</PageLayout>
