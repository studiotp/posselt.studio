---
import BaseLayout from '../layouts/BaseLayout.astro';
import SmartLink from '../components/ui/SmartLink.astro';
---

<BaseLayout title="Page Not Found — Studio Torsten Posselt" noindex={true} themeClass="bg-slate" bodyClass="error404">
  <div class="error">
    <div class="error__container">
      <h1 class="error__title">404</h1>
      <p>The page you are looking for does not exist.</p>
      <SmartLink href="/">Go back home</SmartLink>
    </div>
  </div>
</BaseLayout>
