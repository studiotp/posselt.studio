---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSlider from '../components/projects/ProjectSlider.astro';
import { readFileSync } from 'fs';
import { parse as parseYaml } from 'yaml';
import { join } from 'path';

const allProjects = await getCollection('projects');

// Load custom project order from config file
let projectOrder: string[] = [];
try {
  const configPath = join(process.cwd(), 'src/config/projects-order.yaml');
  const configContent = readFileSync(configPath, 'utf-8');
  const config = parseYaml(configContent);
  projectOrder = config.order || [];
} catch (e) {
  console.warn('Could not load projects-order.yaml, falling back to alphabetical order');
}

// Create a map for quick lookup of order index
const orderIndexMap = new Map(projectOrder.map((slug, index) => [slug, index]));

const activeProjects = allProjects
  .filter((p) => p.data.status === 'active')
  .sort((a, b) => {
    const indexA = orderIndexMap.get(a.id);
    const indexB = orderIndexMap.get(b.id);
    
    // Both projects have explicit order
    if (indexA !== undefined && indexB !== undefined) {
      return indexA - indexB;
    }
    // Only A has explicit order - comes first
    if (indexA !== undefined) return -1;
    // Only B has explicit order - comes first
    if (indexB !== undefined) return 1;
    // Neither has explicit order - alphabetical fallback
    return a.id.localeCompare(b.id);
  });
---

<BaseLayout
  title="STP - Studio Torsten Posselt"
  description="A collection of design projects by Studio Torsten Posselt — from artworks, branding, packaging and editorial design to immersive spatial installations."
  themeClass="bg-white"
  bodyClass="home"
>
  <ul class="projects">
    {activeProjects.map((project, index) => (
      <ProjectSlider project={project} index={index} />
    ))}
  </ul>

  <div class="back-to-top back-to-top-home">
    <a href="#">O</a>
  </div>

  <script>
    import { SliderHandler } from '../scripts/slider.js';
    import { VideoHandler } from '../scripts/video.js';
    import LazyLoad from 'vanilla-lazyload';

    // Initialize sliders
    SliderHandler.init();

    // Initialize video controls
    VideoHandler.init();

    // Initialize lazy loading
    const lazyContent = new LazyLoad({
      elements_selector: 'img.lazy, video.lazy'
    });

    // Video intersection observer (pauses videos when not in viewport)
    const videos = document.querySelectorAll('video');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.intersectionRatio < 0.8) {
            (entry.target as HTMLVideoElement).pause();
          } else {
            const video = entry.target as HTMLVideoElement;
            const autoplay = video.getAttribute('data-autoplay');
            const isActive = video.closest('.slider__slide')?.classList.contains('slider__slide--active');
            if (autoplay === 'true' && isActive) {
              video.play();
            }
          }
        });
      },
      { threshold: 0.8 }
    );

    videos.forEach((video) => observer.observe(video));

    // Update URL hash as user scrolls through projects
    const projectItems = document.querySelectorAll('.projects__item');
    let lastHash = location.hash.slice(1);
    let scrollTimer = null;
    const HYSTERESIS = window.innerHeight * 0.15; // ~15% of viewport

    const updateHash = () => {
      const viewportCenter = window.scrollY + window.innerHeight / 2;
      let closest = null;
      let closestDist = Infinity;

      projectItems.forEach((item) => {
        const rect = item.getBoundingClientRect();
        const itemCenter = window.scrollY + rect.top + rect.height / 2;
        const dist = Math.abs(itemCenter - viewportCenter);
        if (dist < closestDist) {
          closestDist = dist;
          closest = item;
        }
      });

      if (closest && closest.id !== lastHash) {
        // Only switch if the new project is significantly more centered
        const current = document.getElementById(lastHash);
        if (current) {
          const curRect = current.getBoundingClientRect();
          const curCenter = window.scrollY + curRect.top + curRect.height / 2;
          const curDist = Math.abs(curCenter - viewportCenter);
          if (closestDist < curDist - HYSTERESIS) {
            lastHash = closest.id;
            history.replaceState(null, '', '#' + closest.id);
          }
        } else {
          lastHash = closest.id;
          history.replaceState(null, '', '#' + closest.id);
        }
      }
    };

    window.addEventListener('scroll', () => {
      if (scrollTimer) return;
      scrollTimer = window.setTimeout(() => {
        scrollTimer = null;
        updateHash();
      }, 150);
    }, { passive: true });

    // On load with a hash, prevent browser auto-scroll to collapsed element,
    // then manually scroll after layout has settled.
    if (location.hash) {
      const targetId = location.hash.slice(1);
      const target = document.getElementById(targetId);
      if (target) {
        const originalHash = location.hash;
        // Strip hash so the browser won't jump to the (still-collapsed) element
        history.replaceState(null, '', location.pathname + location.search);

        window.setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth' });
          history.replaceState(null, '', originalHash);
          lastHash = targetId;
        }, 800);
      }
    }
  </script>
</BaseLayout>
