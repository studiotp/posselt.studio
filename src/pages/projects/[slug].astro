---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, client, year, description, url, slides } = project.data;
const slug = project.id;

const allImages = import.meta.glob('/src/content/projects/**/*', { eager: true });

function resolveImageModule(projectId: string, src: string) {
  const cleanSrc = src.replace(/^\.\//, '');
  const absolutePath = `/src/content/projects/${projectId}/${cleanSrc}`;
  const mod = allImages[absolutePath] as any;
  return mod?.default ?? null;
}

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

const slideData = await Promise.all(
  slides.map(async (slide, i) => {
    const count = `${i + 1} / ${slides.length}`;
    const cap = slide.caption || '\u00A0';
    const caption = `${count}<br>${escapeHtml(cap)}`;

    if (slide.type === 'image') {
      const imgMod = resolveImageModule(slug, slide.src);
      return {
        type: 'image' as const,
        slide,
        caption,
        imgMod,
      };
    }

    const posterMod = slide.poster ? resolveImageModule(slug, slide.poster) : null;
    const posterOptimized = posterMod
      ? await getImage({ src: posterMod, width: 1200 })
      : null;
    return {
      type: 'video' as const,
      slide,
      caption,
      posterUrl: posterOptimized?.src ?? null,
    };
  })
);

const initialCaption = slideData[0]?.caption || '';
---

<PageLayout
  title={`${title} — Studio Torsten Posselt`}
  description={description || `${title} by Studio Torsten Posselt.`}
  themeClass="bg-white"
  bodyClass="page-project"
>
  <div class="bg-white px-2 lg:px-3 page">
    <div class="lg:pl-4">
      <div class="flex justify-end mb-15 pt-20 md:py-3">
        <div class="w-1/2">
          <h1 class="text-lg md:text-xl relative md:z-30">{client} — {title}</h1>
        </div>
      </div>

      {description && (
        <div class="md:flex mb-5">
          <div class="lg:w-7/12 text-lg md:text-xl leading-large text">
            <p>{description}</p>
          </div>
        </div>
      )}

      <div class="slider" data-project="0" id={`slider--${slug}`}>
        <div class="slider__slides">
          {slideData.map((data, i) => (
            <div
              data-caption={data.caption}
              data-slide={i}
              data-project="0"
              class={`slider__slide${i === 0 ? ' slider__slide--active' : ''}`}
            >
              {data.type === 'video' ? (
                <div
                  class={`video-player slider__image lazy${data.slide.autoplay ? '' : ' videowithcontrols'} media-landscape`}
                  id={`video_${slug}_${i}`}
                >
                  <video
                    class="video-player lazy"
                    poster={data.posterUrl || undefined}
                    data-autoplay={String(data.slide.autoplay ?? false)}
                    muted={data.slide.autoplay ? true : undefined}
                    loop={data.slide.autoplay ? true : undefined}
                    playsinline
                    disablepictureinpicture
                    controlslist="nodownload"
                  >
                    <source src={data.slide.src} type="video/mp4" />
                    Your browser doesn't support HTML5 video.
                  </video>
                  {!data.slide.autoplay && (
                    <div class="big-play-button">
                      <svg class="big-play-button-icon" viewBox="0 0 100 100">
                        <use xlink:href="#svg_playCircle" />
                      </svg>
                    </div>
                  )}
                </div>
              ) : data.imgMod ? (
                <div class="image-wrapper media-landscape">
                  <Image
                    src={data.imgMod}
                    alt={data.slide.alt || ''}
                    widths={[400, 800, 1200, 1600, 2000]}
                    sizes="100vw"
                    class="slider__image"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ) : (
                <div class="image-wrapper media-landscape">
                  <img
                    class="slider__image"
                    src=""
                    alt={data.slide.alt || ''}
                  />
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="slider__footer">
          <div class="slider__caption">
            <span class="slide-caption" set:html={initialCaption} />
          </div>
        </div>
      </div>

      {url && (
        <div class="md:flex pb-20 columns text">
          <div class="lg:w-7/12 text">
            <p>
              <a href={url} target="_blank" rel="noopener">{url}</a>
            </p>
          </div>
        </div>
      )}
    </div>
  </div>

  <script>
    import { SliderHandler } from '../../scripts/slider.js';
    import { VideoHandler } from '../../scripts/video.js';
    import LazyLoad from 'vanilla-lazyload';

    SliderHandler.init();
    VideoHandler.init();

    new LazyLoad({
      elements_selector: 'video.lazy'
    });
  </script>
</PageLayout>
