---
import PageLayout from '../layouts/PageLayout.astro';
import { marked } from 'marked';
import data from '../data/about.json';

const bioHtml = await Promise.all(data.bio.map(async (text) => marked(text)));
const portfolioHtml = await marked(data.sidebar.portfolio.text);
const internshipHtml = await marked(data.sidebar.internships.text);
---

<PageLayout
  title={data.title}
  description={data.description}
  themeClass={data.themeClass}
  bodyClass={data.bodyClass}
>
<div class={`${data.themeClass} px-2 lg:px-3 page`}>
    <div class="lg:pl-4">
        <div class="flex justify-end -mr-2 md:mr-0 mb-15 pt-20 md:py-3">
            <div class="w-[calc(var(--logo-width)+var(--corner-margin)+2rem)] md:w-1/2 md:pl-2">
                <h1 class="text-lg md:text-xl relative md:z-30">{data.heading}</h1>
            </div>
        </div>

        <div class="md:flex mb-5">
            <div class="lg:w-7/12 text-lg md:text-xl leading-large text">
                <p>{data.introduction}</p>
                <p set:html={marked(data.clients)}></p>
            </div>
        </div>

        <div class="md:flex mb-10 justify-start columns">
            <div class="lg:w-5/12 text column">
                {bioHtml.map((html) => (
                  <p set:html={html}></p>
                ))}
            </div>

            <div class="lg:w-1/12 column">&nbsp;</div>

            <div class="lg:w-3/12 text-white column">
                <h2 class="font-bold">{data.sidebar.portfolio.heading}</h2>
                <div class="mb-4 text" set:html={portfolioHtml}></div>

                <h2 class="font-bold">{data.sidebar.internships.heading}</h2>
                <div class="mb-4 text" set:html={internshipHtml}></div>
            </div>
        </div>

        <div class="md:flex mb-15">
            <div class="lg:w-10/12"></div>
        </div>

        <div class="md:flex pb-20 columns text">
            <div class="lg:w-2/12 column mb-10">
                <div class="font-bold">{data.footer.contact.heading}</div>
                <p set:html={marked(data.footer.contact.address.replace(/\n/g, '  \n'))}></p>
                <p>
                    {data.footer.contact.email}<br>
                    <a href={data.footer.contact.mapsUrl} target="_blank" rel="noopener">Maps</a>
                </p>
                <p>on <a href={data.footer.contact.instagramUrl} target="_blank" rel="noopener">Instagram</a></p>
            </div>

            <div class="lg:w-3/12 column">
                <div class="font-bold">{data.footer.copyright.heading}</div>
                <p>{data.footer.copyright.text}</p>
            </div>
        </div>
    </div>
</div>
</PageLayout>
