---
import type { CollectionEntry } from 'astro:content';
import { baseUrl } from '../../lib/paths.ts';

export interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, client, url } = project.data;
const slides = project.data.slides;
const slug = project.id;

function resolveAssetPath(src: string): string {
  if (src.startsWith('http') || src.startsWith('/')) {
    return baseUrl(src);
  }
  return baseUrl(`/projects/${slug}/${src}`);
}

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

// Build captions for each slide
const captions = slides.map((slide, i) => {
  const count = `${i + 1} / ${slides.length}`;
  const cap = slide.caption || '\u00A0';
  return `${count}<br>${escapeHtml(cap)}`;
});

const initialCaption = captions[0] || '';
---

<li class="projects__item" id={slug}>
  <div class="slider" data-project={index}>
    <div class="slider__slides">
      {slides.map((slide, i) => (
        <div
          data-caption={captions[i]}
          data-slide={i}
          data-project={index}
          class={`slider__slide${i === 0 ? ' slider__slide--active' : ''}`}
        >
          {slide.type === 'video' ? (
            <div
              class={`video-player slider__image lazy${slide.autoplay ? '' : ' videowithcontrols'} media-landscape`}
              id={`video_${slug}_${i}`}
            >
              <video
                class="video-player"
                poster={slide.poster ? resolveAssetPath(slide.poster) : undefined}
                data-autoplay={String(slide.autoplay ?? false)}
                muted={slide.autoplay ? true : undefined}
                loop={slide.autoplay ? true : undefined}
                playsinline
                disablepictureinpicture
                controlslist="nodownload"
              >
                <source src={slide.src} type="video/mp4" />
                Your browser doesn't support HTML5 video.
              </video>
              {!slide.autoplay && (
                <div class="big-play-button">
                  <svg class="big-play-button-icon" viewBox="0 0 100 100">
                    <use xlink:href="#svg_playCircle" />
                  </svg>
                </div>
              )}
            </div>
          ) : (
            <div class="image-wrapper media-landscape">
              <img
                class="slider__image lazy"
                data-src={resolveAssetPath(slide.src)}
                alt={slide.alt || ''}
              />
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="slider__footer">
      <div class="slider__caption">
        <h2>{client} — {title}</h2>
        {url && (
          <> — <a href={url} target="_blank" rel="noopener">{url}</a></>
        )}
        <span class="slide-caption" set:html={initialCaption} />
      </div>

    </div>
  </div>
</li>
