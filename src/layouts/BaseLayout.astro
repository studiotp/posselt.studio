---
import '../styles/global.css';
import MetaTags from '../components/head/MetaTags.astro';
import Favicons from '../components/head/Favicons.astro';
import SkipToContent from '../components/layout/SkipToContent.astro';
import STPShell from '../components/layout/STPShell.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  canonical?: string;
  lang?: string;
  bodyClass?: string;
  themeClass: string;
}

const {
  title,
  description,
  ogImage,
  noindex,
  canonical,
  lang = 'en',
  bodyClass,
  themeClass,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <MetaTags
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      canonical={canonical}
    />
    <Favicons />

    <!-- Adobe Typekit (legacy placeholder) -->
    <!-- <link rel="stylesheet" href="https://use.typekit.net/ppf8krb.css"> -->

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <SkipToContent />
    <STPShell themeClass={themeClass}>
      <slot />
    </STPShell>
  </body>
</html>
