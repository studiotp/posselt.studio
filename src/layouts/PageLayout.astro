---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  canonical?: string;
  lang?: string;
  bodyClass?: string;
  themeClass: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <slot />
  <div class="back-to-top bg-white">
    <a href="#">O</a>
  </div>
</BaseLayout>
